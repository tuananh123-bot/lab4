package calserver;
import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.PrintWriter;
import java.net.Socket;
public class calclient {
	  private static final String SERVER_HOST = "localhost";
	    private static final int SERVER_PORT = 5000;

	    public static void main(String[] args) {
	        System.out.println("=== CALC TCP CLIENT CONNECTING TO " + SERVER_HOST + ":" + SERVER_PORT + " ===");
	        try (
	            Socket socket = new Socket(SERVER_HOST, SERVER_PORT);
	            BufferedReader in = new BufferedReader(new InputStreamReader(socket.getInputStream()));
	            PrintWriter out = new PrintWriter(socket.getOutputStream(), true);
	            BufferedReader stdIn = new BufferedReader(new InputStreamReader(System.in))
	        ) {
	            System.out.println("Kết nối thành công!");
	            System.out.println("Cú pháp gửi lệnh: CALC <toán_tử> <toán_hạng_1> <toán_hạng_2>");
	            System.out.println("Ví dụ: CALC + 100 200");
	            System.out.println("Gõ 'QUIT' hoặc 'EXIT' để thoát.\n");

	            String userInput;
	            while (true) {
	                System.out.print("Nhập lệnh > ");
	                userInput = stdIn.readLine();
	                if (userInput == null || userInput.equalsIgnoreCase("QUIT") || userInput.equalsIgnoreCase("EXIT")) {
	                    out.println("QUIT");
	                    break;
	                }

	                // Gửi lệnh lên Server
	                out.println(userInput);

	                // Nhận phản hồi từ Server
	                String response = in.readLine();
	                System.out.println("Server phản hồi: " + response + "\n");
	            }
	        } catch (Exception e) {
	            System.err.println("Lỗi kết nối Client: " + e.getMessage());
	        }
	    }
}
